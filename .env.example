# ============================================================
# CEWERS - Environment Configuration (copy to .env and adjust)
# ============================================================

# --- Database (PostgreSQL + PostGIS) ---
# Native PostgreSQL 18 install (not Docker).
DATABASE_URL=postgresql://postgres:Samolan123@localhost:5432/bescewers?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Samolan123
POSTGRES_DB=bescewers

# --- Redis (sessions, queues, pub/sub) ---
# Uses Docker for Redis only — or set to a native Redis if installed.
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO - S3 compatible, for incident media) ---
# MinIO via Docker, or set to AWS S3 / Azure Blob in production.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=cewers_minio
MINIO_SECRET_KEY=cewers_minio_secret
MINIO_BUCKET=cewers-media
MINIO_USE_SSL=false

# --- Auth ---
JWT_ACCESS_SECRET=cewers_dev_access_secret_change_in_prod_32chars
JWT_REFRESH_SECRET=cewers_dev_refresh_secret_change_in_prod_32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- API ---
API_PORT=4000
API_HOST=localhost
CORS_ORIGIN=http://localhost:5280
SOCKETIO_CORS_ORIGIN=http://localhost:5280

# --- Console (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# --- USSD/SMS Gateway (Africa's Talking sandbox) ---
# Leave blank to use the local mock gateway (no telco contract needed for dev)
AT_USERNAME=
AT_API_KEY=
AT_USSD_CODE=*937*100#
AT_SMS_SHORTCODE=20379
AT_CALLBACK_BASE_URL=http://localhost:4000
USSD_GATEWAY_MODE=mock

# --- Alert Engine ---
ALERT_RECOMPUTE_INTERVAL_MS=300000
